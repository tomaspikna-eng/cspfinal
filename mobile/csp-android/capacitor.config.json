{
  "appId": "com.connectsportspro.app",
  "appName": "Connect Sports Pro",
  "webDir": "www",
  "server": {
    "url": "https://connectsportspro.com",
    "cleartext": false
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": [
        "badge",
        "sound",
        "alert"
      ]
    }
  },
  "backgroundColor": "#08080c",
  "android": {
    "backgroundColor": "#08080c",
    "allowMixedContent": false,
    "captureInput": true
  }
}
