{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Connect Sports Pro",
  "version": "0.1.0",
  "identifier": "com.connectsportspro.desktop",
  "build": {
    "frontendDist": "https://connectsportspro.com/login/"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Connect Sports Pro",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Connect Sports Pro",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": [
          "English",
          "Slovak"
        ]
      }
    }
  }
}
